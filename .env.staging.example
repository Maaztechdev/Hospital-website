NODE_ENV=production
PORT=4000
DATABASE_URL=replace-with-staging-database-url
REDIS_URL=replace-with-staging-redis-url
JWT_ACCESS_SECRET=inject-from-staging-secret-manager
JWT_REFRESH_SECRET=inject-from-staging-secret-manager
PASSWORD_RESET_SECRET=inject-from-staging-secret-manager
FRONTEND_URL=https://staging.example.com
BACKUP_DIR=/srv/careplus/backups
UPLOAD_DIR=/srv/careplus/uploads
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
