# App Configuration
NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1

# Database (Postgres via Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/careplus_test?schema=public

# Redis (sessions / refresh tokens / rate limit / lockout)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset token
PASSWORD_RESET_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
PASSWORD_RESET_EXPIRES_IN=30m

# CORS
FRONTEND_URL=http://localhost:5173

# Security
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_IP_MAX=100
LOGIN_ACCOUNT_FAIL_MAX=20
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
TRUST_PROXY_HOPS=1

# Logging
LOG_LEVEL=warn

# Invoice / MR numbering
MR_NUMBER_PREFIX=MR
INVOICE_NUMBER_PREFIX=INV
