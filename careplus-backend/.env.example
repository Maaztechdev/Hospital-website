# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (Postgres via Prisma) ───────────────────────
DATABASE_URL=postgresql://<db-user>:<db-password>@localhost:5432/careplus?schema=public

# ── Redis (sessions / refresh tokens / rate limit / lockout) ─
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-secret-at-least-32-characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Password reset token ─────────────────────────────────
PASSWORD_RESET_SECRET=<generate-a-random-secret-at-least-32-characters>
PASSWORD_RESET_EXPIRES_IN=30m
EXPOSE_DEV_RESET_TOKEN=false
TRUST_PROXY_HOPS=0

# ── CORS ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Security ──────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info

# ── Invoice / MR numbering ───────────────────────────────
MR_NUMBER_PREFIX=MR
INVOICE_NUMBER_PREFIX=INV
