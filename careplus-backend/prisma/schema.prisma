  entries LabLedgerEntry[]
  referringLabOrders LabOrder[] @relation("LabOrderReferringClinic")

  @@index([type, partyName])
  @@index([partyType, partyName])
  @@map("lab_ledger_accounts")
}

model LabLedgerEntry {
  id             String             @id @default(uuid())
  accountId      String             @map("account_id")
  type           LabLedgerEntryType
  amount         Decimal            @db.Decimal(12, 2)
  balanceAfter   Decimal            @map("balance_after") @db.Decimal(12, 2)
  invoiceId      String?            @map("invoice_id")
  labOrderId     String?            @unique @map("lab_order_id")
  paymentMethod  PaymentMethod?     @map("payment_method")
  notes          String?
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")

  account  LabLedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
