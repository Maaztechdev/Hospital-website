// ════════════════════════════════════════════════════════════════
// CarePlus Hospital Management System — Prisma Schema
// PostgreSQL. UUID PKs. created_at/updated_at everywhere.
// deleted_at soft-delete on sensitive tables. Enums for all statuses.
// ════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  BILLING_MANAGER
  RECEPTIONIST
  DOCTOR
  LAB_TECHNICIAN
  PATHOLOGIST
  ULTRASOUND_TECH
  ULTRASOUND_TECHNICIAN
  RADIOLOGIST
  PHARMACIST
  NURSE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum AppointmentStatus {
  PENDING_APPROVAL
  CONFIRMED
  WAITING
  IN_CONSULTATION
  DONE
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum AppointmentType {
  NEW_VISIT
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentSource {
  WEBSITE
  WALK_IN
  PHONE
}

enum Priority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  COMPLETED
  VOID
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  VERIFIED
  CANCELLED
}

enum LabInterpretation {
  NORMAL
  HIGH
  LOW
  CRITICAL
}

enum LabParameterResultType {
  NUMERIC
  TEXT
  CHOICE
}

enum LabReferenceGender {
  MALE
  FEMALE
  ANY
}

enum LabParameterInterpretation {
  LOW
  NORMAL
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
}

enum LabOrderEventType {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_SAVED
  VERIFIED
  AMENDED
  PRINTED
  CANCELLED
  SAMPLE_REJECTED
  SAMPLE_RECOLLECTED
}

enum LabSampleRejectionReason {
  HAEMOLYSED
  INSUFFICIENT_QUANTITY
  WRONG_TUBE
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  DAMAGED
}

enum LabInventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum LabLedgerAccountType {
  RECEIVABLE
  PAYABLE
}

enum LabLedgerPartyType {
  PATIENT
  CLINIC
  REFERENCE_LAB
}

enum LabLedgerEntryType {
  INVOICE_CHARGE
  PAYMENT_RECEIVED
  SEND_OUT_CHARGE
  PAYMENT_MADE
  ADJUSTMENT
}

enum PharmacyLedgerAccountType {
  RECEIVABLE
  PAYABLE
}

enum PharmacyLedgerEntryType {
  SALE_ON_CREDIT
  PAYMENT_RECEIVED
  PAYMENT_MADE
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIAL
  UNPAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  LAB
  MEDICINE
  WARD
  OT
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  ONLINE
  CREDIT
}

enum WardType {
  GENERAL
  PRIVATE
  ICU
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
}

enum AdmissionType {
  EMERGENCY
  PLANNED
  REFERRAL
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum NursingTaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum OTStatus {
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  COMPLETED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_PENDING
  APPOINTMENT_CONFIRMED
  LAB_RESULT_READY
  CRITICAL_LAB_RESULT
  LOW_STOCK_MEDICINE
  NEAR_EXPIRY_MEDICINE
  BED_AVAILABLE
  PAYMENT_PENDING
  DISCHARGE_REMINDER
  SURGERY_STARTING_SOON
  OT_CHECKLIST_INCOMPLETE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SIGN
  VERIFY
  DISPENSE
  ADMIT
  TRANSFER
  DISCHARGE
  VOID
  STATUS_CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  BACKUP
  RESTORE
}

// ──────────────────────────────────────────────────────────────
// AUTH / USERS
// ──────────────────────────────────────────────────────────────

model Department {
  id        String           @id @default(uuid())
  name      String           @unique
  hodId     String?          @map("hod_id")
  status    DepartmentStatus @default(ACTIVE)
  icon      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users        User[]
  doctors      Doctor[]
  hod          Doctor?       @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([status])
  @@index([hodId])
  @@map("departments")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?
  passwordHash      String    @map("password_hash")
  role              Role
  profilePictureUrl String?   @map("profile_picture_url")
  departmentId      String?   @map("department_id")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  department                 Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  staffProfile               StaffProfile?
  doctorProfile              Doctor?
  createdPatients            Patient[]            @relation("PatientCreatedBy")
  auditLogs                  AuditLog[]
  notifications              Notification[]
  nurseAssignments           NurseAssignment[]
  authAttempts               AuthAttempt[]
  ultrasoundTechnicianOrders UltrasoundOrder[]    @relation("UltrasoundTechnician")
  ultrasoundReportsPerformed UltrasoundReport[]   @relation("UltrasoundReportPerformedBy")
  pharmacySales              PharmacySale[]
  verifiedLabOrders          LabOrder[]           @relation("LabOrderVerifier")
  authoredLabResults         LabResult[]          @relation("LabResultCreator")
  labOrderEvents             LabOrderEvent[]
  rejectedLabSamples         LabSampleRejection[] @relation("LabSampleRejector")
  recollectedLabSamples      LabSampleRejection[] @relation("LabSampleRecollector")
  labInventoryMovements      LabInventoryMovement[] @relation("LabInventoryMovementCreator")
  labInventoryConsumptions   LabInventoryConsumption[] @relation("LabInventoryConsumptionCreator")
  pharmacyLedgerAccounts     PharmacyLedgerAccount[] @relation("PharmacyLedgerAccountCreator")
  pharmacyLedgerEntries      PharmacyLedgerEntry[] @relation("PharmacyLedgerEntryCreator")
  labLedgerEntries            LabLedgerEntry[] @relation("LabLedgerEntryCreator")
  labLedgerAccounts           LabLedgerAccount[] @relation("LabLedgerAccountCreator")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model StaffProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  qualification      String?
  specialization     String?
  registrationNumber String?  @map("registration_number")
  signatureUrl       String?  @map("signature_url")
  stampUrl           String?  @map("stamp_url")
  consultationFee    Decimal? @map("consultation_fee") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model RolePermission {
  id             String   @id @default(uuid())
  role           Role
  module         String
  allowedActions String[] @map("allowed_actions")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([role, module])
  @@map("role_permissions")
}

model AuthAttempt {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
  @@map("auth_attempts")
}

// ──────────────────────────────────────────────────────────────
// PATIENTS
// ──────────────────────────────────────────────────────────────

model Patient {
  id                    String      @id @default(uuid())
  mrNumber              String      @unique @map("mr_number")
  firstName             String      @map("first_name")
  lastName              String      @map("last_name")
  age                   Int?
  /// Deprecated: legacy DOB kept temporarily for migration backfill; prefer age.
  dateOfBirth           DateTime?   @map("date_of_birth") @db.Date
  gender                Gender
  phone                 String
  email                 String?
  address               String?
  cnic                  String?
  bloodGroup            BloodGroup? @map("blood_group")
  allergies             String[]    @default([])
  emergencyContactName  String?     @map("emergency_contact_name")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  notes                 String?
  isTest                Boolean     @default(false) @map("is_test")
  mergedIntoPatientId   String?     @map("merged_into_patient_id")
  createdBy             String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  creator           User               @relation("PatientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  appointments      Appointment[]
  consultations     Consultation[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  labLedgerAccounts LabLedgerAccount[]
  pharmacyLedgerAccount PharmacyLedgerAccount?
  ultrasoundOrders  UltrasoundOrder[]  @relation("UltrasoundPatient")
  ultrasoundReports UltrasoundReport[]
  invoices          Invoice[]
  admissions        Admission[]
  surgeries         Surgery[]

  @@index([phone])
  @@index([mrNumber])
  @@index([email])
  @@index([cnic])
  @@index([lastName, firstName])
  @@map("patients")
}

// Sequence tracker used inside a transaction to safely generate MR-YYYY-NNNNNN
model MrNumberSequence {
  year    Int @id
  counter Int @default(0)

  @@map("mr_number_sequences")
}

// ──────────────────────────────────────────────────────────────
// DOCTORS / APPOINTMENTS
// ──────────────────────────────────────────────────────────────

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  departmentId    String?  @map("department_id")
  qualification   String?
  specialization  String?
  experienceYears Int?     @map("experience_years")
  consultationFee Decimal  @map("consultation_fee") @db.Decimal(10, 2)
  isAvailable     Boolean  @default(true) @map("is_available")
  scheduleJson    Json?    @map("schedule_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user                     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  department               Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartments        Department[]           @relation("DepartmentHod")
  appointments             Appointment[]
  consultations            Consultation[]
  prescriptions            Prescription[]
  labOrders                LabOrder[]
  ultrasoundOrders         UltrasoundOrder[]      @relation("UltrasoundOrderingDoctor")
  ultrasoundReportsOrdered UltrasoundReport[]     @relation("UltrasoundReportOrderedBy")
  admissions               Admission[]            @relation("AttendingDoctor")
  surgeriesAsSurgeon       Surgery[]              @relation("Surgeon")
  surgeriesAsAnesthetist   Surgery[]              @relation("Anesthetist")
  prescriptionPadConfig    PrescriptionPadConfig?

  @@map("doctors")
}

model Appointment {
  id              String                 @id @default(uuid())
  patientId       String                 @map("patient_id")
  doctorId        String                 @map("doctor_id")
  departmentId    String?                @map("department_id")
  appointmentDate DateTime               @map("appointment_date") @db.Date
  timeSlot        Unsupported("TIME(0)") @map("time_slot")
  tokenNumber     Int                    @map("token_number")
  appointmentType AppointmentType        @map("appointment_type")
  status          AppointmentStatus      @default(PENDING_APPROVAL)
  priority        Priority               @default(ROUTINE)
  source          AppointmentSource      @default(WALK_IN)
  reason          String?
  rejectionReason String?                @map("rejection_reason")
  notes           String?
  isTest          Boolean                @default(false) @map("is_test")
  waitingSince    DateTime?              @map("waiting_since")
  createdBy       String                 @map("created_by")
  approvedBy      String?                @map("approved_by")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor            Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  consultation      Consultation?
  ultrasoundReports UltrasoundReport[]

  @@unique([doctorId, appointmentDate, tokenNumber])
  @@index([appointmentDate])
  @@index([status])
  @@index([patientId])
  @@index([appointmentDate, status])
  @@index([status, appointmentDate])
  @@map("appointments")
}

// Per-doctor per-day token counter (transaction-safe)
model AppointmentTokenSequence {
  doctorId String   @map("doctor_id")
  date     DateTime @db.Date
  counter  Int      @default(0)

  @@id([doctorId, date])
  @@map("appointment_token_sequences")
}

// ──────────────────────────────────────────────────────────────
// CONSULTATIONS / PRESCRIPTIONS
// ──────────────────────────────────────────────────────────────

model Consultation {
  id                 String             @id @default(uuid())
  appointmentId      String             @unique @map("appointment_id")
  patientId          String             @map("patient_id")
  doctorId           String             @map("doctor_id")
  chiefComplaint     String?            @map("chief_complaint")
  vitalsJson         Json?              @map("vitals_json")
  diagnosis          String?
  findings           String?
  clinicalNotes      String?            @map("clinical_notes")
  prescriptionStatus PrescriptionStatus @default(DRAFT) @map("prescription_status")
  followUpDate       DateTime?          @map("follow_up_date") @db.Date
  referral           String?
  startedAt          DateTime?          @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  signedAt           DateTime?          @map("signed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  ultrasoundOrders UltrasoundOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@map("consultations")
}

model Prescription {
  id                    String             @id @default(uuid())
  consultationId        String             @map("consultation_id")
  patientId             String             @map("patient_id")
  doctorId              String             @map("doctor_id")
  visitNumber           String?            @map("visit_number")
  visitDate             DateTime?          @map("visit_date")
  visitTime             String?            @map("visit_time")
  relationship          String?
  patientAddress        String?            @map("patient_address")
  patientContact        String?            @map("patient_contact")
  patientAge            Int?               @map("patient_age")
  patientGender         Gender?
  patientWeight         String?            @map("patient_weight")
  vitalsJson            Json?              @map("vitals_json")
  allergies             String?
  presentingComplaints  String?            @map("presenting_complaints")
  history               String?
  findings              String?
  investigations        String?
  rxText                String?            @map("rx_text")
  refillNumber          Int                @default(0) @map("refill_number")
  configurationSnapshot Json?              @map("configuration_snapshot")
  status                PrescriptionStatus @default(DRAFT)
  voidReason            String?            @map("void_reason")
  signedAt              DateTime?          @map("signed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")
  signIdempotencyKey    String?            @unique @map("sign_idempotency_key")

  consultation Consultation       @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId, createdAt])
  @@index([consultationId])
  @@map("prescriptions")
}

model PrescriptionPadConfig {
  id                   String   @id @default(uuid())
  doctorId             String   @unique @map("doctor_id")
  clinicName           String   @map("clinic_name")
  clinicAddress        String?
  clinicPhone          String?
  clinicEmail          String?
  doctorName           String?
  doctorQualification  String?
  doctorSpecialization String?
  pmdcRegistrationNo   String?  @map("pmdc_registration_no")
  phcRegistrationNo    String?  @map("phc_registration_no")
  otherRegistrationNo  String?  @map("other_registration_no")
  clinicDaysTimings    String?  @map("clinic_days_timings")
  refillText           String?  @map("refill_text")
  dispensingStampText  String?  @map("dispensing_stamp_text")
  logoUrl              String?  @map("logo_url")
  qrCodeUrl            String?  @map("qr_code_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("prescription_pad_configs")
}

model PrescriptionItem {
  id                String  @id @default(uuid())
  prescriptionId    String  @map("prescription_id")
  medicineId        String? @map("medicine_id")
  medicineName      String  @map("medicine_name")
  dosage            String
  route             String
  frequency         String
  durationDays      Int     @map("duration_days")
  instructions      String?
  quantityDispensed Int     @default(0) @map("quantity_dispensed")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@map("prescription_items")
}

// ──────────────────────────────────────────────────────────────
// LABORATORY
// ──────────────────────────────────────────────────────────────

model LabTest {
  id                  String   @id @default(uuid())
  testName            String   @map("test_name")
  testCode            String   @unique @map("test_code")
  category            String?
  sampleType          String?  @map("sample_type")
  price               Decimal  @db.Decimal(10, 2)
  unit                String?
  referenceRangeMin   Decimal? @map("reference_range_min") @db.Decimal(10, 2)
  referenceRangeMax   Decimal? @map("reference_range_max") @db.Decimal(10, 2)
  turnaroundTimeHours Int?     @map("turnaround_time_hours")
  isActive            Boolean  @default(true) @map("is_active")
  isSendOut           Boolean  @default(false) @map("is_send_out")
  referenceLabSupplierId String? @map("reference_lab_supplier_id")
  sendOutCost         Decimal? @map("send_out_cost") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  labOrders  LabOrder[]
  packages   LabPackageTest[]
  parameters LabTestParameter[]
  inventoryMappings LabTestInventoryMapping[]
  referenceLabSupplier Supplier? @relation("LabTestReferenceLab", fields: [referenceLabSupplierId], references: [id], onDelete: SetNull)

  @@map("lab_tests")
}

model LabTestParameter {
  id            String                 @id @default(uuid())
  testId        String                 @map("test_id")
  name          String
  unit          String?
  displayOrder  Int                    @default(0) @map("display_order")
  resultType    LabParameterResultType @default(NUMERIC) @map("result_type")
  decimalPlaces Int                    @default(2) @map("decimal_places")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  test    LabTest              @relation(fields: [testId], references: [id], onDelete: Restrict)
  ranges  LabReferenceRange[]
  results LabResultParameter[]

  @@unique([testId, name])
  @@index([testId, isActive, displayOrder])
  @@map("lab_test_parameters")
}

model LabReferenceRange {
  id           String             @id @default(uuid())
  parameterId  String             @map("parameter_id")
  gender       LabReferenceGender @default(ANY)
  ageMinDays   Int?               @map("age_min_days")
  ageMaxDays   Int?               @map("age_max_days")
  low          Decimal?           @db.Decimal(12, 4)
  high         Decimal?           @db.Decimal(12, 4)
  criticalLow  Decimal?           @map("critical_low") @db.Decimal(12, 4)
  criticalHigh Decimal?           @map("critical_high") @db.Decimal(12, 4)
  notes        String?
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  parameter LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@index([parameterId, gender, isActive])
  @@map("lab_reference_ranges")
}

model LabPackage {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tests    LabPackageTest[]
  invoices Invoice[]

  @@map("lab_packages")
}

model LabPackageTest {
  packageId    String   @map("package_id")
  testId       String   @map("test_id")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  package LabPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  test    LabTest    @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@id([packageId, testId])
  @@index([testId])
  @@map("lab_package_tests")
}

model LabOrder {
  id                String         @id @default(uuid())
  orderNumber       String         @unique @map("order_number")
  patientId         String         @map("patient_id")
  doctorId          String?        @map("doctor_id")
  testId            String         @map("test_id")
  status            LabOrderStatus @default(ORDERED)
  priority          Priority       @default(ROUTINE)
  sampleType        String?        @map("sample_type")
  clinicalNotes     String?        @map("clinical_notes")
  orderedAt         DateTime       @default(now()) @map("ordered_at")
  sampleCollectedAt DateTime?      @map("sample_collected_at")
  completedAt       DateTime?      @map("completed_at")
  verifiedAt        DateTime?      @map("verified_at")
  verifiedBy        String?        @map("verified_by")
  criticalResult    Boolean        @default(false) @map("critical_result")
  createdBy         String         @map("created_by")
  consultationId    String?        @map("consultation_id")
  invoiceId         String?        @map("invoice_id")
  referringClinicAccountId String? @map("referring_clinic_account_id")

  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor?               @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  test         LabTest               @relation(fields: [testId], references: [id], onDelete: Restrict)
  results      LabResult[]
  attachments  LabReportAttachment[]
  consultation Consultation?         @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  verifier     User?                 @relation("LabOrderVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  events       LabOrderEvent[]
  rejections   LabSampleRejection[]
  inventoryConsumption LabInventoryConsumption?
  referringClinicAccount LabLedgerAccount? @relation("LabOrderReferringClinic", fields: [referringClinicAccountId], references: [id], onDelete: SetNull)
  ledgerEntries LabLedgerEntry[]

  @@index([patientId])
  @@index([status])
  @@index([consultationId])
  @@index([invoiceId])
  @@index([referringClinicAccountId])
  @@map("lab_orders")
}

model LabResult {
  id              String             @id @default(uuid())
  labOrderId      String             @map("lab_order_id")
  resultValue     String             @map("result_value")
  unit            String?
  referenceRange  String?            @map("reference_range")
  interpretation  LabInterpretation?
  technicianNotes String?            @map("technician_notes")
  reportRemarks   String?            @map("report_remarks")
  amendmentReason String?            @map("amendment_reason")
  amendedAt       DateTime?          @map("amended_at")
  supersededById  String?            @map("superseded_by_id")
  verifiedBy      String?            @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  createdBy       String?            @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")

  labOrder   LabOrder             @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  creator    User?                @relation("LabResultCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  parameters LabResultParameter[]
  inventoryConsumption LabInventoryConsumption?

  @@index([labOrderId])
  @@map("lab_results")
}

model LabResultParameter {
  id                       String                      @id @default(uuid())
  labResultId              String                      @map("lab_result_id")
  parameterId              String?                     @map("parameter_id")
  parameterName            String                      @map("parameter_name")
  value                    String
  unit                     String?
  referenceRange           String?                     @map("reference_range")
  computedInterpretation   LabParameterInterpretation? @map("computed_interpretation")
  overriddenInterpretation LabParameterInterpretation? @map("overridden_interpretation")
  overrideReason           String?                     @map("override_reason")
  createdAt                DateTime                    @default(now()) @map("created_at")

  result    LabResult         @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  parameter LabTestParameter? @relation(fields: [parameterId], references: [id], onDelete: SetNull)

  @@index([labResultId])
  @@index([parameterId])
  @@map("lab_result_parameters")
}

model LabOrderEvent {
  id         String            @id @default(uuid())
  labOrderId String            @map("lab_order_id")
  actorId    String?           @map("actor_id")
  eventType  LabOrderEventType @map("event_type")
  oldValues  Json?             @map("old_values")
  newValues  Json?             @map("new_values")
  createdAt  DateTime          @default(now()) @map("created_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([labOrderId, createdAt])
  @@map("lab_order_events")
}

model LabSampleRejection {
  id            String                   @id @default(uuid())
  labOrderId    String                   @map("lab_order_id")
  reason        LabSampleRejectionReason
  otherReason   String?                  @map("other_reason")
  rejectedBy    String?                  @map("rejected_by")
  rejectedAt    DateTime                 @default(now()) @map("rejected_at")
  recollectedBy String?                  @map("recollected_by")
  recollectedAt DateTime?                @map("recollected_at")

  labOrder    LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  rejector    User?    @relation("LabSampleRejector", fields: [rejectedBy], references: [id], onDelete: SetNull)
  recollector User?    @relation("LabSampleRecollector", fields: [recollectedBy], references: [id], onDelete: SetNull)

  @@index([labOrderId, rejectedAt])
  @@map("lab_sample_rejections")
}

model LabInventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String
  unit        String
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(12, 3)
  supplierId  String?  @map("supplier_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  batches  LabInventoryBatch[]
  mappings LabTestInventoryMapping[]

  @@index([name])
  @@index([isActive])
  @@map("lab_inventory_items")
}

model LabInventoryBatch {
  id            String   @id @default(uuid())
  itemId        String   @map("item_id")
  batchNumber   String   @map("batch_number")
  expiryDate    DateTime @map("expiry_date") @db.Date
  quantity      Decimal  @db.Decimal(12, 3)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  supplierId    String?  @map("supplier_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  item          LabInventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier      Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements     LabInventoryMovement[]

  @@unique([itemId, batchNumber])
  @@index([itemId, expiryDate])
  @@map("lab_inventory_batches")
}

model LabTestInventoryMapping {
  id                 String  @id @default(uuid())
  testId             String  @map("test_id")
  itemId             String  @map("item_id")
