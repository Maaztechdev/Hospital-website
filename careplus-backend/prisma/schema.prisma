model InvoiceNumberSequence {
  year    Int @id
  counter Int @default(0)

  @@map("invoice_number_sequences")
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique @map("invoice_number")
  patientId          String?       @map("patient_id")
  createdBy          String        @map("created_by")
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountType       String?       @map("discount_type")
  discountReason     String?       @map("discount_reason")
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal         Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount      Decimal       @default(0) @map("balance_amount") @db.Decimal(12, 2)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  voidedAt           DateTime?     @map("voided_at")
  voidReason         String?       @map("void_reason")
  voidedBy           String?       @map("voided_by")
  discountAppliedBy  String?       @map("discount_applied_by")
  discountApprovedBy String?       @map("discount_approved_by")
  labPackageId       String?       @map("lab_package_id")

  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]
  pharmacySale PharmacySale?
  labOrders    LabOrder[]
  labPackage   LabPackage?   @relation(fields: [labPackageId], references: [id], onDelete: SetNull)
  labLedgerEntries LabLedgerEntry[]
  pharmacyLedgerEntries PharmacyLedgerEntry[]

  @@index([patientId])
  @@index([status])
  @@index([labPackageId])
  @@map("invoices")
}

model LabLedgerAccount {
  id         String               @id @default(uuid())
  type       LabLedgerAccountType
  partyType  LabLedgerPartyType   @map("party_type")
