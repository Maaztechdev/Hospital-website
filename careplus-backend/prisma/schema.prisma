  createdAt     DateTime                @default(now()) @map("created_at")

  batch   LabInventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creator User              @relation("LabInventoryMovementCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([createdAt])
  @@map("lab_inventory_movements")
}

model LabOrderNumberSequence {
  year    Int @id
  counter Int @default(0)

  @@map("lab_order_number_sequences")
}

model LabReportAttachment {
  id               String   @id @default(uuid())
  labOrderId       String   @map("lab_order_id")
  fileUrl          String   @map("file_url")
  originalFilename String?  @map("original_filename")
