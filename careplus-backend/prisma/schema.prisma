// ════════════════════════════════════════════════════════════════
// CarePlus Hospital Management System — Prisma Schema
// PostgreSQL. UUID PKs. created_at/updated_at everywhere.
// deleted_at soft-delete on sensitive tables. Enums for all statuses.
// ════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_TECHNICIAN
  ULTRASOUND_TECHNICIAN
  RADIOLOGIST
  PHARMACIST
  NURSE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum AppointmentStatus {
  PENDING_APPROVAL
  CONFIRMED
  WAITING
  IN_CONSULTATION
  DONE
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  NEW_VISIT
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentSource {
  WEBSITE
  WALK_IN
  PHONE
}

enum Priority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  COMPLETED
  VOID
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  VERIFIED
  CANCELLED
}

enum LabInterpretation {
  NORMAL
  HIGH
  LOW
  CRITICAL
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  EXPIRED
  DAMAGED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIAL
  UNPAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  LAB
  MEDICINE
  WARD
  OT
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
}

enum WardType {
  GENERAL
  PRIVATE
  ICU
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
}

enum AdmissionType {
  EMERGENCY
  PLANNED
  REFERRAL
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum NursingTaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum OTStatus {
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  COMPLETED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_PENDING
  APPOINTMENT_CONFIRMED
  LAB_RESULT_READY
  CRITICAL_LAB_RESULT
  LOW_STOCK_MEDICINE
  NEAR_EXPIRY_MEDICINE
  BED_AVAILABLE
  PAYMENT_PENDING
  DISCHARGE_REMINDER
  SURGERY_STARTING_SOON
  OT_CHECKLIST_INCOMPLETE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SIGN
  VERIFY
  DISPENSE
  ADMIT
  TRANSFER
  DISCHARGE
  VOID
  STATUS_CHANGE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  BACKUP
  RESTORE
}

// ──────────────────────────────────────────────────────────────
// AUTH / USERS
// ──────────────────────────────────────────────────────────────

model Department {
  id        String           @id @default(uuid())
  name      String           @unique
  hodId     String?          @map("hod_id")
  status    DepartmentStatus @default(ACTIVE)
  icon      String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users     User[]
  doctors   Doctor[]
  hod       Doctor?          @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([status])
  @@index([hodId])

  @@map("departments")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  role         Role
  departmentId String?   @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department       Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  doctorProfile    Doctor?
  createdPatients  Patient[]          @relation("PatientCreatedBy")
  auditLogs        AuditLog[]
  notifications    Notification[]
  nurseAssignments NurseAssignment[]
  authAttempts     AuthAttempt[]
  ultrasoundTechnicianOrders UltrasoundOrder[] @relation("UltrasoundTechnician")
  pharmacySales PharmacySale[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model RolePermission {
  id              String   @id @default(uuid())
  role            Role
  module          String
  allowedActions  String[] @map("allowed_actions")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([role, module])
  @@map("role_permissions")
}

model AuthAttempt {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
  @@map("auth_attempts")
}

// ──────────────────────────────────────────────────────────────
// PATIENTS
// ──────────────────────────────────────────────────────────────

model Patient {
  id                     String      @id @default(uuid())
  mrNumber               String      @unique @map("mr_number")
  firstName              String      @map("first_name")
  lastName               String      @map("last_name")
  dateOfBirth            DateTime    @map("date_of_birth")
  age                    Int
  gender                 Gender
  phone                  String
  email                  String?
  address                String?
  cnic                   String?
  bloodGroup             BloodGroup? @map("blood_group")
  allergies              String[]    @default([])
  emergencyContactName   String?     @map("emergency_contact_name")
  emergencyContactPhone  String?     @map("emergency_contact_phone")
  notes                  String?
  mergedIntoPatientId    String?     @map("merged_into_patient_id")
  createdBy              String      @map("created_by")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")

  creator       User            @relation("PatientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  ultrasoundOrders UltrasoundOrder[] @relation("UltrasoundPatient")
  invoices      Invoice[]
  admissions    Admission[]
  surgeries     Surgery[]

  @@index([phone])
  @@index([mrNumber])
  @@index([email])
  @@index([cnic])
  @@index([lastName, firstName])
  @@map("patients")
}

// Sequence tracker used inside a transaction to safely generate MR-YYYY-NNNNNN
model MrNumberSequence {
  year    Int @id
  counter Int @default(0)

  @@map("mr_number_sequences")
}

// ──────────────────────────────────────────────────────────────
// DOCTORS / APPOINTMENTS
// ──────────────────────────────────────────────────────────────

model Doctor {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  departmentId      String?  @map("department_id")
  qualification     String?
  specialization     String?
  experienceYears   Int?     @map("experience_years")
  consultationFee   Decimal  @map("consultation_fee") @db.Decimal(10, 2)
  isAvailable       Boolean  @default(true) @map("is_available")
  scheduleJson      Json?    @map("schedule_json")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartments Department[] @relation("DepartmentHod")
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  ultrasoundOrders UltrasoundOrder[] @relation("UltrasoundOrderingDoctor")
  admissions    Admission[]      @relation("AttendingDoctor")
  surgeriesAsSurgeon    Surgery[] @relation("Surgeon")
  surgeriesAsAnesthetist Surgery[] @relation("Anesthetist")

  @@map("doctors")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  doctorId        String            @map("doctor_id")
  departmentId    String?           @map("department_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  timeSlot        String            @map("time_slot")
  tokenNumber     Int               @map("token_number")
  appointmentType AppointmentType   @map("appointment_type")
  status          AppointmentStatus @default(PENDING_APPROVAL)
  priority        Priority          @default(ROUTINE)
  source          AppointmentSource @default(WALK_IN)
  reason          String?
  rejectionReason String?           @map("rejection_reason")
  notes           String?
  waitingSince    DateTime?         @map("waiting_since")
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  consultation Consultation?

  @@unique([doctorId, appointmentDate, timeSlot])
  @@index([appointmentDate])
  @@index([status])
  @@index([patientId])
  @@index([appointmentDate, status])
  @@index([status, appointmentDate])
  @@map("appointments")
}

// Per-doctor per-day token counter (transaction-safe)
model AppointmentTokenSequence {
  doctorId String   @map("doctor_id")
  date     DateTime @db.Date
  counter  Int      @default(0)

  @@id([doctorId, date])
  @@map("appointment_token_sequences")
}

// ──────────────────────────────────────────────────────────────
// CONSULTATIONS / PRESCRIPTIONS
// ──────────────────────────────────────────────────────────────

model Consultation {
  id                 String              @id @default(uuid())
  appointmentId      String              @unique @map("appointment_id")
  patientId          String              @map("patient_id")
  doctorId           String              @map("doctor_id")
  chiefComplaint     String?             @map("chief_complaint")
  vitalsJson         Json?               @map("vitals_json")
  diagnosis          String?
  clinicalNotes      String?             @map("clinical_notes")
  prescriptionStatus PrescriptionStatus  @default(DRAFT) @map("prescription_status")
  followUpDate       DateTime?           @map("follow_up_date") @db.Date
  referral           String?
  signedAt           DateTime?           @map("signed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescriptions Prescription[]
  labOrders     LabOrder[]
  ultrasoundOrders UltrasoundOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@map("consultations")
}

model Prescription {
  id             String             @id @default(uuid())
  consultationId String             @map("consultation_id")
  patientId      String             @map("patient_id")
  doctorId       String             @map("doctor_id")
  status         PrescriptionStatus @default(DRAFT)
  voidReason     String?            @map("void_reason")
  signedAt       DateTime?          @map("signed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  signIdempotencyKey String?        @unique @map("sign_idempotency_key")

  consultation Consultation        @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                String   @id @default(uuid())
  prescriptionId    String   @map("prescription_id")
  medicineId        String?  @map("medicine_id")
  medicineName      String   @map("medicine_name")
  dosage            String
  route             String
  frequency         String
  durationDays      Int      @map("duration_days")
  instructions      String?
  quantityDispensed Int      @default(0) @map("quantity_dispensed")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@map("prescription_items")
}

// ──────────────────────────────────────────────────────────────
// LABORATORY
// ──────────────────────────────────────────────────────────────

model LabTest {
  id                 String   @id @default(uuid())
  testName           String   @map("test_name")
  testCode           String   @unique @map("test_code")
  category           String?
  price              Decimal  @db.Decimal(10, 2)
  unit               String?
  referenceRangeMin  Decimal? @map("reference_range_min") @db.Decimal(10, 2)
  referenceRangeMax  Decimal? @map("reference_range_max") @db.Decimal(10, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  labOrders LabOrder[]

  @@map("lab_tests")
}

model LabOrder {
  id                String         @id @default(uuid())
  patientId         String         @map("patient_id")
  doctorId          String?        @map("doctor_id")
  testId            String         @map("test_id")
  status            LabOrderStatus @default(ORDERED)
  priority          Priority       @default(ROUTINE)
  sampleType        String?        @map("sample_type")
  clinicalNotes     String?        @map("clinical_notes")
  orderedAt         DateTime       @default(now()) @map("ordered_at")
  sampleCollectedAt DateTime?      @map("sample_collected_at")
  completedAt       DateTime?      @map("completed_at")
  verifiedAt        DateTime?      @map("verified_at")
  createdBy         String         @map("created_by")
  consultationId    String?        @map("consultation_id")

  patient     Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor?               @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  test        LabTest               @relation(fields: [testId], references: [id], onDelete: Restrict)
  results     LabResult[]
  attachments LabReportAttachment[]
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([status])
  @@index([consultationId])
  @@map("lab_orders")
}

model LabResult {
  id               String            @id @default(uuid())
  labOrderId       String            @map("lab_order_id")
  resultValue      String            @map("result_value")
  unit             String?
  referenceRange   String?           @map("reference_range")
  interpretation   LabInterpretation?
  technicianNotes  String?           @map("technician_notes")
  amendmentReason  String?           @map("amendment_reason")
  supersededById   String?           @map("superseded_by_id")
  verifiedBy       String?           @map("verified_by")
  verifiedAt       DateTime?         @map("verified_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)

  @@index([labOrderId])
  @@map("lab_results")
}

model LabReportAttachment {
  id         String   @id @default(uuid())
  labOrderId String   @map("lab_order_id")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)

  @@map("lab_report_attachments")
}

enum UltrasoundOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model UltrasoundOrder {
  id           String               @id @default(uuid())
  patientId    String               @map("patient_id")
  doctorId     String               @map("doctor_id")
  technicianId String?              @map("technician_id")
  examType     String               @map("exam_type")
  status       UltrasoundOrderStatus @default(ORDERED)
  scheduledAt  DateTime?            @map("scheduled_at")
  performedAt  DateTime?            @map("performed_at")
  completedAt  DateTime?            @map("completed_at")
  findings     String?
  impression   String?
  imageUrls    String[]             @default([]) @map("image_urls")
  priority     Priority             @default(ROUTINE)
  notes        String?
  consultationId String?           @map("consultation_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  patient    Patient @relation("UltrasoundPatient", fields: [patientId], references: [id], onDelete: Restrict)
  doctor     Doctor  @relation("UltrasoundOrderingDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  technician User?   @relation("UltrasoundTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([technicianId])
  @@index([status, scheduledAt])
  @@index([consultationId])
  @@map("ultrasound_orders")
}

// ──────────────────────────────────────────────────────────────
// PHARMACY & INVENTORY
// ──────────────────────────────────────────────────────────────

model MedicineCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")

  medicines Medicine[]

  @@map("medicine_categories")
}

model Medicine {
  id          String   @id @default(uuid())
  name        String
  genericName String?  @map("generic_name")
  strength    String?
  form        String?
  categoryId  String?  @map("category_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category           MedicineCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches             MedicineBatch[]
  prescriptionItems   PrescriptionItem[]
  pharmacySaleItems   PharmacySaleItem[]

  @@index([name])
  @@map("medicines")
}

model Supplier {
  id        String          @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime        @default(now()) @map("created_at")

  batches   MedicineBatch[]

  @@map("suppliers")
}

model MedicineBatch {
  id            String   @id @default(uuid())
  medicineId    String   @map("medicine_id")
  batchNumber   String   @map("batch_number")
  expiryDate    DateTime @map("expiry_date") @db.Date
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(10, 2)
  stockQuantity Int      @map("stock_quantity")
  reorderLevel  Int      @default(10) @map("reorder_level")
  supplierId    String?  @map("supplier_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  medicine       Medicine        @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  pharmacySaleItems PharmacySaleItem[]

  @@index([medicineId])
  @@index([expiryDate])
  @@map("medicine_batches")
}

model StockMovement {
  id            String            @id @default(uuid())
  batchId       String            @map("batch_id")
  movementType  StockMovementType @map("movement_type")
  quantity      Int
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  reason        String?
  createdBy     String            @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  batch MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([createdAt])
  @@index([batchId, createdAt])
  @@map("stock_movements")
}

// ──────────────────────────────────────────────────────────────
// BILLING & INVOICING
// ──────────────────────────────────────────────────────────────

model InvoiceNumberSequence {
  year    Int @id
  counter Int @default(0)

  @@map("invoice_number_sequences")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  patientId      String?       @map("patient_id")
  createdBy      String        @map("created_by")
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountType   String?       @map("discount_type")
  discountReason String?       @map("discount_reason")
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal     Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount  Decimal       @default(0) @map("balance_amount") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  voidedAt       DateTime?     @map("voided_at")
  voidReason     String?       @map("void_reason")

  patient Patient?       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items   InvoiceItem[]
  payments Payment[]
  pharmacySale PharmacySale?

  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  itemType    InvoiceItemType @map("item_type")
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  subtotal    Decimal         @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("invoice_items")
}

model PharmacySale {
  id             String        @id @default(uuid())
  invoiceId      String        @unique @map("invoice_id")
  cashierId      String        @map("cashier_id")
  customerName   String?       @map("customer_name")
  customerPhone  String?       @map("customer_phone")
  paymentMethod  PaymentMethod @map("payment_method")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  idempotencyKey String?       @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashier User @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items PharmacySaleItem[]

  @@index([createdAt])
  @@map("pharmacy_sales")
}

model PharmacySaleItem {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  medicineId String  @map("medicine_id")
  batchId   String   @map("batch_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  sale PharmacySale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([medicineId])
  @@map("pharmacy_sale_items")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @default(now()) @map("payment_date")
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  deletedAt       DateTime?     @map("deleted_at")
  idempotencyKey  String?       @unique @map("idempotency_key")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────
// WARD & BED MANAGEMENT
// ──────────────────────────────────────────────────────────────

model Ward {
  id       String   @id @default(uuid())
  wardName String   @map("ward_name")
  wardType WardType @map("ward_type")
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  rooms Room[]

  @@map("wards")
}

model Room {
  id         String  @id @default(uuid())
  wardId     String  @map("ward_id")
  roomNumber String  @map("room_number")
  isActive   Boolean @default(true) @map("is_active")

  ward Ward   @relation(fields: [wardId], references: [id], onDelete: Restrict)
  beds Bed[]

  @@map("rooms")
}

model Bed {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  bedNumber String    @map("bed_number")
  bedLabel  String?   @map("bed_label")
  dailyRate Decimal   @default(0) @map("daily_rate") @db.Decimal(10, 2)
  status    BedStatus @default(AVAILABLE)
  isActive  Boolean   @default(true) @map("is_active")

  room             Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  admissions       Admission[]
  transfersFrom    BedTransfer[] @relation("FromBed")
  transfersTo      BedTransfer[] @relation("ToBed")

  @@index([status])
  @@map("beds")
}

model Admission {
  id                 String          @id @default(uuid())
  patientId          String          @map("patient_id")
  bedId              String          @map("bed_id")
  attendingDoctorId  String          @map("attending_doctor_id")
  admissionType      AdmissionType   @default(PLANNED) @map("admission_type")
  admissionDate      DateTime        @default(now()) @map("admission_date")
  admissionReason    String          @map("admission_reason")
  depositAmount      Decimal         @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status             AdmissionStatus @default(ACTIVE)
  dischargeDate      DateTime?       @map("discharge_date")
  dischargeSummary   String?         @map("discharge_summary")
  dischargeNotes     String?         @map("discharge_notes")
  createdBy          String          @map("created_by")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  bed              Bed                @relation(fields: [bedId], references: [id], onDelete: Restrict)
  attendingDoctor  Doctor             @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id], onDelete: Restrict)
  transfers        BedTransfer[]
  vitalsHistory    PatientVitals[]
  nursingTasks     NursingTask[]

  @@index([patientId])
  @@index([status])
  @@map("admissions")
}

model BedTransfer {
  id           String   @id @default(uuid())
  admissionId  String   @map("admission_id")
  fromBedId    String   @map("from_bed_id")
  toBedId      String   @map("to_bed_id")
  transferDate DateTime @default(now()) @map("transfer_date")
  reason       String
  createdBy    String   @map("created_by")

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  fromBed   Bed       @relation("FromBed", fields: [fromBedId], references: [id], onDelete: Restrict)
  toBed     Bed       @relation("ToBed", fields: [toBedId], references: [id], onDelete: Restrict)

  @@map("bed_transfers")
}

// ──────────────────────────────────────────────────────────────
// NURSING
// ──────────────────────────────────────────────────────────────

model NurseAssignment {
  id         String    @id @default(uuid())
  nurseUserId String   @map("nurse_user_id")
  wardId     String    @map("ward_id")
  shiftDate  DateTime  @map("shift_date") @db.Date
  shiftType  ShiftType @map("shift_type")
  isActive   Boolean   @default(true) @map("is_active")

  nurse User @relation(fields: [nurseUserId], references: [id], onDelete: Restrict)

  @@index([wardId, shiftDate])
  @@map("nurse_assignments")
}

model PatientVitals {
  id                String   @id @default(uuid())
  admissionId       String   @map("admission_id")
  patientId         String   @map("patient_id")
  recordedBy        String   @map("recorded_by")
  recordedAt        DateTime @default(now()) @map("recorded_at")
  bpSystolic        Int?     @map("bp_systolic")
  bpDiastolic       Int?     @map("bp_diastolic")
  temperature       Decimal? @db.Decimal(4, 1)
  pulse             Int?
  respiratoryRate   Int?     @map("respiratory_rate")
  oxygenSaturation  Int?     @map("oxygen_saturation")
  painScore         Int?     @map("pain_score")
  notes             String?

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@index([admissionId])
  @@map("patient_vitals_history")
}

model NursingTask {
  id              String            @id @default(uuid())
  admissionId     String            @map("admission_id")
  taskDescription String            @map("task_description")
  dueAt           DateTime?         @map("due_at")
  completedAt     DateTime?         @map("completed_at")
  completedBy     String?           @map("completed_by")
  status          NursingTaskStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@index([admissionId])
  @@map("nursing_tasks")
}

// ──────────────────────────────────────────────────────────────
// OPERATION THEATRE
// ──────────────────────────────────────────────────────────────

model OtRoom {
  id       String   @id @default(uuid())
  roomName String   @map("room_name")
  isActive Boolean  @default(true) @map("is_active")

  surgeries Surgery[]

  @@map("ot_rooms")
}

model Surgery {
  id                 String    @id @default(uuid())
  patientId          String    @map("patient_id")
  otRoomId           String    @map("ot_room_id")
  surgeryType        String    @map("surgery_type")
  surgeonId          String    @map("surgeon_id")
  anesthetistId      String?   @map("anesthetist_id")
  scheduledStart     DateTime  @map("scheduled_start")
  scheduledEnd       DateTime  @map("scheduled_end")
  actualStart        DateTime? @map("actual_start")
  actualEnd          DateTime? @map("actual_end")
  status             OTStatus  @default(SCHEDULED)
  preOpChecklistJson Json      @default("{\"consent_form_confirmed\":false,\"fasting_confirmed\":false,\"blood_arranged\":false,\"identity_verified\":false,\"allergies_checked\":false,\"pre_op_vitals_recorded\":false,\"required_reports_reviewed\":false}") @map("pre_op_checklist_json")
  postOpNotes        String?   @map("post_op_notes")
  complications      String?
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  otRoom      OtRoom  @relation(fields: [otRoomId], references: [id], onDelete: Restrict)
  surgeon     Doctor  @relation("Surgeon", fields: [surgeonId], references: [id], onDelete: Restrict)
  anesthetist Doctor? @relation("Anesthetist", fields: [anesthetistId], references: [id], onDelete: SetNull)

  @@index([otRoomId, scheduledStart])
  @@index([surgeonId, scheduledStart])
  @@index([status])
  @@map("surgeries")
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  notificationType  NotificationType @map("notification_type")
  title             String
  message           String
  isRead            Boolean          @default(false) @map("is_read")
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model WhatsappMessageLog {
  id          String   @id @default(uuid())
  toPhone     String   @map("to_phone")
  templateKey String   @map("template_key")
  payloadJson Json?    @map("payload_json")
  status      String   @default("QUEUED")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("whatsapp_message_log")
}

// ──────────────────────────────────────────────────────────────
// SETTINGS
// ──────────────────────────────────────────────────────────────

model HospitalProfile {
  id               String   @id @default("default")
  name             String
  registrationNo   String?  @map("registration_no")
  address          String?
  phone            String?
  email            String?
  logoUrl          String?  @map("logo_url")
  faviconUrl       String?  @map("favicon_url")
  emergencyContact String?  @map("emergency_contact")
  taxId            String?  @map("tax_id")
  currency         String   @default("PKR")
  timezone         String   @default("Asia/Karachi")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("hospital_profiles")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Backup {
  id        String   @id @default(uuid())
  filename  String   @unique
  sizeBytes BigInt   @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backups")
}

// ──────────────────────────────────────────────────────────────
// AUDIT LOG
// ──────────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  action        AuditAction
  module        String
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id")
  oldValuesJson Json?       @map("old_values_json")
  newValuesJson Json?       @map("new_values_json")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([module, createdAt])
  @@map("audit_logs")
}
