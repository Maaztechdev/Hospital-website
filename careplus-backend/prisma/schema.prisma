  @@unique([testId, itemId])
  @@index([testId])
  @@map("lab_test_inventory_mappings")
}

model LabInventoryConsumption {
  id             String   @id @default(uuid())
  labOrderId     String   @unique @map("lab_order_id")
  resultId       String   @unique @map("result_id")
  overrideReason String?  @map("override_reason")
  details        Json
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  result   LabResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  creator  User     @relation("LabInventoryConsumptionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("lab_inventory_consumptions")
}

model LabInventoryMovement {
  id            String                  @id @default(uuid())
  batchId       String                  @map("batch_id")
