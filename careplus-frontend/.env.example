# ── Frontend Environment Configuration ───────────────────────

# Backend API base URL including the version prefix
# For local development: http://localhost:4000/api/v1
# For production: https://api.yourhospital.com/api/v1 or /api/v1 (if reverse proxied)
VITE_API_URL=http://localhost:4000/api/v1

# Inactivity session warning modal lead time in milliseconds (default: 2 minutes)
VITE_SESSION_WARNING_LEAD_MS=120000

# Total session inactivity timeout in milliseconds before auto-logout (default: 13 minutes)
VITE_SESSION_INACTIVITY_TIMEOUT_MS=780000
