# ── CarePlus Hospital System - Environment Configuration ──────
# All values shown below are documented placeholders.
# Generate strong, unique random secrets for production deployments.

# ── Database (PostgreSQL) ──────────────────────────────────
POSTGRES_USER=careplus
POSTGRES_PASSWORD=<generate-a-strong-random-db-password>
POSTGRES_DB=careplus
DATABASE_URL=postgresql://careplus:<generate-a-strong-random-db-password>@postgres:5432/careplus?schema=public

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT Authentication Secrets (Min 32 random characters) ──
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-secret-at-least-32-characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=<generate-a-third-random-secret-at-least-32-characters>
PASSWORD_RESET_EXPIRES_IN=30m

# ── Frontend & Networking ──────────────────────────────────
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080
VITE_API_URL=/api/v1
TRUST_PROXY_HOPS=1

# ── Backups & Storage ──────────────────────────────────────
BACKUP_DIR=./backups
AUTO_BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE=0 2 * * *
UPLOAD_DIR=./uploads

# ── Production Bootstrap ───────────────────────────────────
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@yourhospital.com
BOOTSTRAP_ADMIN_PASSWORD=<generate-a-strong-admin-password>

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info